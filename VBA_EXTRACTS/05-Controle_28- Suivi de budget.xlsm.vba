' --- Module: Helper.bas ---
Attribute VB_Name = "Helper"
Option Explicit

Public Sub NavBar()
    Select Case Application.Caller
        Case "BtnGuide": ShGuide.Activate
        Case "BtnVP": ShVP.Activate
        Case "BtnCR": ShCR.Activate
        Case "BtnVA": ShVA.Activate
        Case "BtnSuivi": ShSuivi.Activate
        Case "BtnAvancement": ShAvancement.Activate
    End Select
End Sub

Public Sub startCode()
    Application.EnableEvents = False
    Application.ScreenUpdating = False
    
End Sub

Public Sub stopCode()
    Application.EnableEvents = True
    Application.ScreenUpdating = True
    
End Sub


' --- Module: ShLangue.cls ---
Attribute VB_Name = "ShLangue"
Attribute VB_Base = "0{00020820-0000-0000-C000-000000000046}"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = True
Attribute VB_TemplateDerived = False
Attribute VB_Customizable = True
Option Explicit



' --- Module: Langue.bas ---
Attribute VB_Name = "Langue"
Option Explicit

Public Sub change_langue()
    Dim dict As Object
    Dim dictKey As Variant
    Dim e As Range
    Dim trad As String
    Dim tabEtat As ListObject
    Dim sh As Shape
    Dim originalText As String
    Dim sht As Worksheet
    startCode
    Set dict = CreateLangDict
    
    With ShVP
        trad = vbNullString
        For Each e In Union(.Range("D1:M4"), .Range("B5"), .Range("N5"), .Range("B7:B8"), .Range("C10:C29"), .Range("B28"), .Range("B5"), .Range("D30"), .Range("D10"))
            trad = dict(e.value)
            If e <> vbNullString And trad <> vbNullString Then
                e = trad
            End If
        Next e
        trad = vbNullString
    End With
    
    With ShCR
        trad = vbNullString
        For Each e In Union(.Range("D2:M4"), .Range("B5"), .Range("B7:B11"), .Range("C11:C32"), .Range("B29"), .Range("D11"))
            trad = dict(e.value)
            If e <> vbNullString And trad <> vbNullString Then
                e = trad
            End If
        Next e
        trad = vbNullString
    End With
    
    With ShVA
        trad = vbNullString
        For Each e In Union(.Range("D2:M4"), .Range("B5"), .Range("B7:B11"), .Range("C11:C32"), .Range("B30"), .Range("D12:Z12"))
            trad = dict(e.value)
            If e <> vbNullString And trad <> vbNullString Then
                e = trad
            End If
        Next e
        trad = vbNullString
    End With
    
    With ShAvancement
        trad = vbNullString
        For Each e In Union(.Range("D2:Q4"), .Range("B5"), .Range("B7:S188"))
            trad = dict(e.value)
            If e <> vbNullString And trad <> vbNullString Then
                e = trad
            End If
        Next e
        trad = vbNullString
    End With

    With ShSuivi
        trad = vbNullString
        For Each e In Union(.Range("D2:M4"), .Range("B5"), .Range("B7:F14"), .Range("B26:D40"), .Range("G23:N23"))
            trad = dict(e.value)
            If e <> vbNullString And trad <> vbNullString Then
                e = trad
            End If
        Next e
        trad = vbNullString
    End With

    With ShLangue
        trad = vbNullString
        For Each e In .Range("F7")
            trad = dict(e.value)
            If e <> vbNullString And trad <> vbNullString Then
                e = trad
            End If
        Next e
        trad = vbNullString
    End With
    For Each sht In ActiveWorkbook.Sheets
        trad = vbNullString
        For Each sh In sht.Shapes
            If sh.Type = 1 Then
                originalText = sh.TextFrame2.TextRange.Text
                trad = dict(originalText)
                If trad <> vbNullString Then
                    sh.TextFrame2.TextRange.Text = trad
                End If
            End If
        Next sh
        trad = dict(sht.Name)
        If trad <> vbNullString Then
            sht.Name = trad
        End If
    Next sht
    stopCode
End Sub

Private Function CreateLangDict() As Object
    Dim dict As Object
    Dim tabLang As ListObject
    Dim key As String
    Dim value As String
    Dim tblRow As ListRow
    Dim dictKey As Variant
    Dim CELL_KEY As Integer
    Dim CELL_VALUE As Integer
    
    CELL_KEY = ShVP.Range("Langue")
    CELL_VALUE = IIf(CELL_KEY = 1, 2, 1)
    Set dict = CreateObject("Scripting.Dictionary")
    Set tabLang = ShLangue.ListObjects("TabLangue")
    
    For Each tblRow In tabLang.ListRows
        key = tblRow.Range.Cells(1, CELL_KEY).value
        value = tblRow.Range.Cells(1, CELL_VALUE).value
        dict(key) = value
    Next tblRow
    

'    For Each dictKey In dict.Keys
'        Debug.Print "Key: " & dictKey & ", Value: " & dict(dictKey)
'    Next dictKey
    Set CreateLangDict = dict
End Function








